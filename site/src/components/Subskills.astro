---
import { subskillsFor } from "../lib/skills";
import { quoteAtor, toolForSkill } from "../lib/tools";

interface Props {
  parent: string;
}

const { parent } = Astro.props;
const subskillLead: Record<string, string> = {
  "day-to-day": "Open the one that matches the tool you're already using.",
  observability: "Start with where the app is hosted, or with Sentry if you need to see errors first.",
  security: "Infisical is the front door. The others go after the keys and the database.",
  scalability: "These are the hosts I look at when more customers would mean more traffic.",
  blindspots: "When one of these is ready, it points at a gap you can't see from the app itself.",
  "whats-next": "A skill lands here when it answers what to do next.",
};
const lead = subskillLead[parent] ?? "More specific skills for this one.";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
const subskills = subskillsFor(parent).map((skill) => {
  const tool = toolForSkill(skill.slug);
  const sentence = skill.description.split(/\.\s/)[0];
  const detail = tool?.stack ?? (sentence.endsWith(".") ? sentence : `${sentence}.`);
  const status = tool?.readiness === "ready" ? "ready" : "pending";
  return {
    href: `/skills/${skill.slug}`,
    name: quoteAtor(tool?.name ?? skill.title),
    aka: tool?.aka,
    url: tool?.url,
    detail,
    status,
    label: status === "ready" ? "Tools I use" : "On the workbench",
  };
}).sort((a, b) => {
  if (a.status !== b.status) return a.status === "ready" ? -1 : 1;
  return a.name.localeCompare(b.name);
});
---

{
  subskills.length === 0 && parent === "blindspots" && (
    <section class="mt-10" aria-label="Subskills">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
        Subskills
      </h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400">No subskills here yet.</p>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
        This is a feature that is more challenging because it's asking a null set problem, which is: what am I not doing that I should be doing? This is still in the build phase, and so while you can ask it, it's a little hard unless you've defined your tech stack. I'm working on my own <a href="/mcp" class="font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50">MCP</a> that allows us to map the tech stack and then look for features that you might need but are looking past.
      </p>
    </section>
  )
}

{
  subskills.length > 0 && (
    <section class="mt-10" aria-label="Subskills">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
        Subskills
      </h2>
      <p class="mt-2 max-w-3xl text-neutral-600 dark:text-neutral-400">{lead}</p>
      <ul class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-3">
        {subskills.map((skill) => (
          <li>
            <div class="group relative h-full cursor-pointer rounded-lg border border-neutral-200 px-4 py-3 shadow-md shadow-neutral-900/10 transition duration-150 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-neutral-900/20 dark:border-neutral-800 dark:shadow-black/40 dark:hover:shadow-black/70">
              {skill.status === "ready" ? (
                <a href={skill.href} class="absolute inset-0 z-10 rounded-lg" aria-label={skill.name}></a>
              ) : (
                <button
                  type="button"
                  data-pending-skill={skill.name}
                  aria-haspopup="dialog"
                  aria-label={`${skill.name} is coming soon`}
                  class="absolute inset-0 z-10 rounded-lg"
                />
              )}
              <span
                class:list={[
                  "pointer-events-none absolute right-3 top-3 rounded-full border px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-[0.12em]",
                    skill.status === "ready" &&
                      "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-200",
                    skill.status === "pending" &&
                    "border-neutral-200 text-neutral-600 dark:border-neutral-700 dark:text-neutral-300",
                ]}
              >
                {skill.label}
              </span>
              <p class="pr-20 text-base font-semibold text-neutral-900 group-hover:underline dark:text-neutral-50">
                {skill.name}
              </p>
              {skill.aka && (
                <p class="relative z-20 mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                  aka{" "}
                  {skill.url ? (
                    <a
                      href={skill.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-50"
                    >
                      {skill.aka}
                    </a>
                  ) : (
                    skill.aka
                  )}
                </p>
              )}
              <p class="mt-1 pr-2 text-neutral-600 dark:text-neutral-400">{skill.detail}</p>
            </div>
          </li>
        ))}
      </ul>
      {subskills.some((skill) => skill.status === "pending") && (
        <dialog
          id="subskill-pending-dialog"
          class="w-[calc(100%-2rem)] max-w-md rounded-2xl border border-neutral-200 bg-white p-6 text-neutral-900 shadow-xl dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50"
        >
          <div class="flex items-start justify-between gap-4">
            <h2 class="text-xl font-semibold tracking-tight">Coming soon</h2>
            <button
              type="button"
              id="subskill-pending-close"
              class="text-sm text-neutral-500 underline-offset-4 hover:underline dark:text-neutral-400"
            >
              Close
            </button>
          </div>
          <p class="mt-3 text-neutral-600 dark:text-neutral-400">
            <span id="subskill-pending-name"></span> is coming soon. It is not battle-ready yet. Subscribe to get an update when this skill comes online.
          </p>
          <p id="subskill-pending-success" class="mt-6 hidden text-neutral-700 dark:text-neutral-200" role="status">
            Check your email to confirm. That is the only next step.
          </p>
          <form id="subskill-pending-form" class="mt-6" novalidate>
            <label for="subskill-pending-email" class="sr-only">Email address</label>
            <div class="flex flex-col gap-2 sm:flex-row">
              <input
                id="subskill-pending-email"
                name="email"
                type="email"
                placeholder="Email address"
                required
                autocomplete="email"
                class="min-h-[40px] w-full min-w-0 flex-1 rounded-full border border-neutral-300 bg-white px-4 text-sm text-neutral-900 placeholder:text-neutral-600 focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/20 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-50 dark:placeholder:text-neutral-400 dark:focus:border-neutral-400 dark:focus:ring-neutral-400/30"
              />
              <button
                type="submit"
                id="subskill-pending-submit"
                class="min-h-[40px] shrink-0 rounded-full bg-emerald-700 px-5 text-xs font-semibold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-50"
              >
                Subscribe free
              </button>
            </div>
            <div
              id="subskill-pending-error"
              class="mt-3 hidden rounded-lg border border-neutral-300 bg-neutral-50 px-4 py-2.5 text-left text-sm text-neutral-800 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100"
              role="alert"
            >
            </div>
          </form>
        </dialog>
      )}
      <script define:vars={{ supabaseUrl, anonKey }}>
        const dialog = document.getElementById("subskill-pending-dialog");
        const nameEl = document.getElementById("subskill-pending-name");
        const closeBtn = document.getElementById("subskill-pending-close");
        const form = document.getElementById("subskill-pending-form");
        const emailInput = document.getElementById("subskill-pending-email");
        const errorEl = document.getElementById("subskill-pending-error");
        const submitBtn = document.getElementById("subskill-pending-submit");
        const successEl = document.getElementById("subskill-pending-success");
        if (!dialog) {
          /* no pending subskills on this page */
        } else {
          function openPending(name) {
            if (!nameEl || !form || !successEl || !errorEl || !emailInput || !submitBtn) return;
            nameEl.textContent = name;
            form.classList.remove("hidden");
            successEl.classList.add("hidden");
            errorEl.classList.add("hidden");
            errorEl.textContent = "";
            emailInput.value = "";
            submitBtn.disabled = false;
            submitBtn.textContent = "Subscribe free";
            dialog.showModal();
          }
          document.querySelectorAll("[data-pending-skill]").forEach((button) => {
            if (button.closest("[aria-label='Subskills']")) {
              button.addEventListener("click", () => {
                openPending(button.getAttribute("data-pending-skill") ?? "This skill");
              });
            }
          });
          closeBtn?.addEventListener("click", () => dialog.close());
          dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
          });
          form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!emailInput || !errorEl || !submitBtn || !successEl || !form) return;
            errorEl.classList.add("hidden");
            errorEl.textContent = "";
            const email = emailInput.value.trim();
            if (!email) return;
            if (!supabaseUrl || !anonKey) {
              errorEl.textContent = "Subscription is not configured yet. Please try again later.";
              errorEl.classList.remove("hidden");
              return;
            }
            submitBtn.disabled = true;
            submitBtn.textContent = "Sending…";
            try {
              const res = await fetch(`${supabaseUrl.replace(/\/$/, "")}/functions/v1/llc-subscribe`, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${anonKey}`,
                  apikey: anonKey,
                },
                body: JSON.stringify({
                  email,
                  source: "skills_site_pending",
                  automation_aliases: ["builder-skills"],
                }),
              });
              if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                throw new Error(data.error ?? `Something went wrong (${res.status}). Try again.`);
              }
              window.posthog?.capture("newsletter_subscribe_completed", { source: "skills_site_pending" });
              form.classList.add("hidden");
              successEl.classList.remove("hidden");
            } catch (err) {
              errorEl.textContent = err instanceof Error ? err.message : "Something went wrong.";
              errorEl.classList.remove("hidden");
              submitBtn.disabled = false;
              submitBtn.textContent = "Subscribe free";
            }
          });
        }
      </script>
    </section>
  )
}
