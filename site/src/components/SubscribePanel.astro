---
import { MAIN_SITE } from "../lib/brand";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
const formId = "skills-subscribe-form";
const source = "skills_site";
const automationAliases = ["builder-skills"];
---

<section
  class="mb-12 rounded-2xl border border-neutral-200 p-6 sm:p-8 dark:border-neutral-800"
  aria-labelledby="skills-subscribe"
>
  <h2
    id="skills-subscribe"
    class="text-xl font-bold tracking-tight text-neutral-900 sm:text-2xl dark:text-neutral-50"
  >
    Get the weekly note
  </h2>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
    Join 1,700 founders and builders. One note a week—straight to your inbox.
  </p>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
    I write about the founder-side of tech decisions: what to buy, what to build, what to skip, and
    what you will regret six months from now. Start with what I've written in
    <a href={`${MAIN_SITE}/insights`} class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-50">Insights</a>,
    browse by
    <a href={`${MAIN_SITE}/themes`} class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-50">theme</a>,
    or see the
    <a href={`${MAIN_SITE}/tools-i-use`} class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-50">tools I use</a>.
  </p>

  <p id={`${formId}-success`} class="mt-6 hidden text-lg text-neutral-700 dark:text-neutral-200" role="status">
    Check your email to confirm. That is the only next step.
  </p>

  <form id={formId} class="mt-6 max-w-md" novalidate>
    <label for={`${formId}-email`} class="sr-only">Email address</label>
    <div
      class="flex flex-col gap-2 sm:flex-row sm:items-stretch sm:gap-0 sm:overflow-hidden sm:rounded-full sm:border sm:border-neutral-300 sm:bg-white sm:focus-within:border-neutral-900 sm:focus-within:ring-2 sm:focus-within:ring-neutral-900/20 dark:sm:border-neutral-600 dark:sm:bg-neutral-900 dark:sm:focus-within:border-neutral-400 dark:sm:focus-within:ring-neutral-400/30"
    >
      <input
        id={`${formId}-email`}
        name="email"
        type="email"
        placeholder="Email address"
        required
        autocomplete="email"
        class="min-h-[40px] w-full min-w-0 flex-1 rounded-full border border-neutral-300 bg-white px-4 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/20 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-50 dark:placeholder:text-neutral-500 dark:focus:border-neutral-400 dark:focus:ring-neutral-400/30 sm:rounded-none sm:border-0 sm:focus:border-transparent sm:focus:ring-0"
      />
      <button
        type="submit"
        id={`${formId}-submit`}
        class="min-h-[40px] shrink-0 rounded-full bg-emerald-700 px-5 text-xs font-semibold text-white transition-colors hover:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-50 sm:rounded-none"
      >
        Subscribe free
      </button>
    </div>
    <div
      id={`${formId}-error`}
      class="mt-3 hidden rounded-lg border border-neutral-300 bg-neutral-50 px-4 py-2.5 text-left text-sm text-neutral-800 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100"
      role="alert"
    >
    </div>
  </form>
</section>

<script define:vars={{ supabaseUrl, anonKey, formId, source, automationAliases }}>
  const form = document.getElementById(formId);
  const emailInput = document.getElementById(`${formId}-email`);
  const errorEl = document.getElementById(`${formId}-error`);
  const submitBtn = document.getElementById(`${formId}-submit`);
  const successEl = document.getElementById(`${formId}-success`);

  if (form && emailInput && errorEl && submitBtn && successEl) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorEl.classList.add("hidden");
      errorEl.textContent = "";

      const email = emailInput.value.trim();
      if (!email) return;

      if (!supabaseUrl || !anonKey) {
        errorEl.textContent = "Subscription is not configured yet. Please try again later.";
        errorEl.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      const defaultLabel = submitBtn.textContent;
      submitBtn.textContent = "Sending…";

      try {
        const res = await fetch(`${supabaseUrl.replace(/\/$/, "")}/functions/v1/llc-subscribe`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${anonKey}`,
            apikey: anonKey,
          },
          body: JSON.stringify({ email, source, automation_aliases: automationAliases }),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error ?? `Something went wrong (${res.status}). Try again.`);
        }

        window.posthog?.capture("newsletter_subscribe_completed", { source });
        form.classList.add("hidden");
        successEl.classList.remove("hidden");
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : "Something went wrong.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = defaultLabel ?? "Subscribe free";
      }
    });
  }
</script>
