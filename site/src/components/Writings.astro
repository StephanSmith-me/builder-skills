---
import type { Writing } from "../lib/tools";

interface Props {
  posts: Writing[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="mt-8" aria-label="I wrote about this">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
        I wrote about this
      </h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-3">
        {posts.map((post) => (
          <li class="rounded-lg border border-neutral-200 px-4 py-4 dark:border-neutral-800">
            {post.kind === "article" ? (
              <>
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
                  In the tools I use
                </p>
                <a
                  href={post.href}
                  class="mt-1 block font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50"
                >
                  {post.title}
                </a>
                <a
                  href={post.site}
                  class="mt-1 block text-neutral-600 underline underline-offset-4 dark:text-neutral-400"
                >
                  stephansmith.me
                </a>
              </>
            ) : (
              <a href={post.href} target="_blank" rel="noopener noreferrer" class="block">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
                  {post.source === "LinkedIn" && (
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                    </svg>
                  )}
                  {post.source}
                </span>
                <span class="mt-1 block font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50">
                  {post.title}
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
