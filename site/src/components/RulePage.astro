---
import Base from "../layouts/Base.astro";
import RepoCallout from "./RepoCallout.astro";
import { formatRuleUpdated, publicRule } from "../lib/ruleMeta";

interface Part {
  name: string;
  detail: string;
  linkHref?: string;
  linkLabel?: string;
  afterLink?: string;
}

interface Props {
  slug: string;
  description: string;
  prompt: string;
  subtitle: string;
  lead: string;
  parts?: Part[];
  issues: string[];
  version?: string;
  updated?: string;
}

const { slug, description, prompt, subtitle, lead, parts = [], issues } = Astro.props;
const stamp = publicRule(slug);
const version = Astro.props.version ?? stamp.version;
const updated = Astro.props.updated ?? stamp.updated;

const updatedLabel = formatRuleUpdated(updated);
---

<Base title={`/${slug} — Stephan Smith`} description={description}>
  <div class="mx-auto max-w-2xl">
    <p>
      <a
        href="/"
        class="text-sm text-neutral-500 underline-offset-4 hover:text-neutral-900 hover:underline dark:text-neutral-400 dark:hover:text-neutral-50"
      >
        Skills
      </a>
    </p>

    <div class="mt-8 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-4 shadow-md shadow-neutral-900/10 dark:border-emerald-800 dark:bg-emerald-950 dark:shadow-black/40">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
        Prompt
      </p>
      <p class="mt-3 font-mono text-sm font-bold leading-relaxed text-neutral-900 dark:text-neutral-50">
        {prompt}
      </p>
      <button
        type="button"
        data-copy={prompt}
        class="mt-4 rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
      >
        Copy
      </button>
    </div>

    <h1 class="mt-10 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50">
      /{slug}
    </h1>
    <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
      v{version} · Updated {updatedLabel}
    </p>
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">{subtitle}</p>
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">{lead}</p>
    {
      parts.length > 0 && (
        <ol class="mt-6 space-y-4">
          {parts.map((part, index) => (
            <li>
              <p class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">
                {index + 1}. {part.name}
              </p>
              <p class="mt-1 text-lg text-neutral-600 dark:text-neutral-400">
                {part.linkHref ? (
                  <>
                    {part.detail}{" "}
                    <a
                      href={part.linkHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50"
                    >
                      {part.linkLabel}
                    </a>
                    {part.afterLink}
                  </>
                ) : (
                  part.detail
                )}
              </p>
            </li>
          ))}
        </ol>
      )
    }

    <h2 class="mt-10 text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
      Five things this rule looks for
    </h2>
    <ol class="mt-4 list-decimal space-y-3 pl-5 text-lg text-neutral-600 dark:text-neutral-400">
      {issues.map((issue) => <li class="pl-1">{issue}</li>)}
    </ol>
    <RepoCallout />
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    if (button.closest(".install-command")) return;
    button.addEventListener("click", async () => {
      const value = button.dataset.copy ?? "";
      await navigator.clipboard.writeText(value);
      const previous = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = previous;
      }, 1400);
    });
  });
</script>
