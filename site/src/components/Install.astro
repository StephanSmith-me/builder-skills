---
const command = "npx skills add StephanSmith-me/builder-skills";
---

<div
  class="install-command mt-8 flex flex-col gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 shadow-md shadow-neutral-900/10 sm:flex-row sm:items-center sm:justify-between dark:border-emerald-800 dark:bg-emerald-950 dark:shadow-black/40"
>
  <code class="install-command__line overflow-x-auto font-mono font-bold text-neutral-900 dark:text-neutral-50">{command}</code>
  <button
    type="button"
    data-copy={command}
    class="shrink-0 rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
  >
    Copy
  </button>
</div>

<style>
  .install-command {
    container-type: inline-size;
  }

  .install-command__line {
    white-space: nowrap;
    font-size: min(0.875rem, 3cqi);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy ?? "";
      await navigator.clipboard.writeText(value);
      const previous = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = previous;
      }, 1400);
    });
  });
</script>
