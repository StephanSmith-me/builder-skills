---
import Base from "../layouts/Base.astro";
import { loadSkills } from "../lib/skills";

const published = new Set(loadSkills().map((skill) => skill.slug));

const groups = [
  {
    name: "Secrets",
    skills: [
      {
        slug: "infisical",
        line: "Decide when secrets should leave a hosted builder or a .env file.",
      },
      {
        slug: "env-inventory",
        line: "See which env names the code still uses, and which are old.",
      },
    ],
  },
  {
    name: "Errors",
    skills: [
      {
        slug: "sentry",
        line: "Decide if Sentry is how this app should catch errors.",
        stub: true,
      },
    ],
  },
  {
    name: "Ship",
    skills: [
      {
        slug: "cloudflare",
        line: "Decide if Cloudflare is the right host or edge.",
        stub: true,
      },
      {
        slug: "github",
        line: "Decide if GitHub is where this code should live and ship.",
        stub: true,
      },
    ],
  },
  {
    name: "Mail",
    skills: [
      {
        slug: "improvmx",
        line: "Decide if ImprovMX should forward mail for this domain.",
        stub: true,
      },
    ],
  },
];

const description =
  "Vendor skills, one product at a time. Infisical and env inventory are written. Sentry, Cloudflare, ImprovMX, and GitHub are stubs.";
---

<Base title="/gallery — Stephan Smith" description={description}>
  <div class="mx-auto max-w-2xl">
    <p>
      <a
        href="/"
        class="text-sm text-neutral-500 underline-offset-4 hover:text-neutral-900 hover:underline dark:text-neutral-400 dark:hover:text-neutral-50"
      >
        Skills
      </a>
    </p>
    <h1 class="mt-8 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50">
      /gallery
    </h1>
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">
      Vendor skills, one product at a time. Each one has its own page. A stub names the tool and stops there.
    </p>

    {
      groups.map((group) => (
        <section class="mt-10">
          <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
            {group.name}
          </h2>
          <ul class="mt-4 grid gap-3">
            {group.skills.map((skill) => (
              <li>
                <a
                  href={published.has(skill.slug) ? `/skills/${skill.slug}` : undefined}
                  class="block rounded-lg border border-neutral-200 px-4 py-4 shadow-md shadow-neutral-900/10 transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:shadow-black/40 dark:hover:border-neutral-600"
                >
                  <p class="font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
                    {skill.slug}
                    {skill.stub && (
                      <span class="ml-2 align-middle text-xs font-medium uppercase tracking-[0.12em] text-neutral-400 dark:text-neutral-500">
                        Stub
                      </span>
                    )}
                  </p>
                  <p class="mt-1 text-neutral-600 dark:text-neutral-400">{skill.line}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
