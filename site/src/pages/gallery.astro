---
import Base from "../layouts/Base.astro";

const tools = ["Infisical", "Cloudflare", "Sentry", "ImprovMX", "GitHub"];

const description =
  "Coming soon. Vendor-specific rules that go deep on Infisical, Cloudflare, Sentry, ImprovMX, and GitHub.";
---

<Base title="/gallery — Stephan Smith" description={description}>
  <div class="mx-auto max-w-2xl">
    <p>
      <a
        href="/"
        class="text-sm text-neutral-500 underline-offset-4 hover:text-neutral-900 hover:underline dark:text-neutral-400 dark:hover:text-neutral-50"
      >
        Skills
      </a>
    </p>
    <p class="mt-8 inline-flex rounded-full border border-neutral-200 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-neutral-900 dark:border-neutral-700 dark:text-neutral-50">
      Coming soon
    </p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50">
      /gallery
    </h1>
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">
      Vendor-specific rules that go deep on the tooling. Each one is for a single product, not the
      whole app. Infisical, Cloudflare, Sentry, ImprovMX, and GitHub are first.
    </p>
    <ul class="mt-8 flex flex-wrap gap-2">
      {
        tools.map((tool) => (
          <li class="rounded-full border border-neutral-200 px-3 py-1 text-sm text-neutral-700 dark:border-neutral-700 dark:text-neutral-300">
            {tool}
          </li>
        ))
      }
    </ul>
  </div>
</Base>
