---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Install from "../components/Install.astro";
import { formatDaysAgo, formatRuleUpdated } from "../lib/ruleMeta";
import { loadSkills } from "../lib/skills";
import { quoteAtor, toolForSkill } from "../lib/tools";

function lastChanges(): Map<string, string> {
  const file = path.resolve(process.cwd(), "..", "VERSIONS.md");
  const dates = new Map<string, string>();
  if (!fs.existsSync(file)) return dates;
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    const match = line.match(/^\|\s*([^|]+?)\s*\|\s*[^|]+\s*\|\s*(\d{4}-\d{2}-\d{2})\s*\|/);
    if (!match || match[1].trim() === "Skill" || match[1].includes("(public page)")) continue;
    dates.set(match[1].trim(), match[2]);
  }
  return dates;
}

const updatedOn = lastChanges();

const description =
  "I have a skill that measures the maturity of my skills. This catalog is built on Agent Skills.";

const prompt =
  "Review this skill and score it for maturity using the Agent Skills spec and recommendations.";

const parents = new Set(["day-to-day", "observability", "security", "scalability", "blindspots", "whats-next"]);

const rows = loadSkills()
  .map((skill) => {
    const tool = toolForSkill(skill.slug);
    const live = parents.has(skill.slug) || tool?.readiness === "ready" || skill.slug === "skill-score";
    return {
      slug: skill.slug,
      name: quoteAtor(tool?.name ?? skill.title),
      href: parents.has(skill.slug) ? `/${skill.slug}` : `/skills/${skill.slug}`,
      version: skill.version,
      updated: updatedOn.get(skill.slug),
      evals: skill.evalCount,
      assets: skill.assetCount,
      references: skill.referenceCount,
      live,
    };
  })
  .sort((a, b) => Number(b.live) - Number(a.live) || a.name.localeCompare(b.name));
---

<Base title="Skill maturity — Stephan Smith" description={description}>
  <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-12">
    <div class="md:w-72 md:shrink-0">
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50">
        Skill maturity
      </h1>
    </div>
    <div class="min-w-0 max-w-3xl flex-1">
      <p class="text-xl leading-relaxed text-neutral-900 dark:text-neutral-50">
        I have a skill that helps me measure the maturity of my skills.
      </p>
      <p class="mt-3 text-xl leading-relaxed text-neutral-900 dark:text-neutral-50">
        This catalog is built on
        <a
          href="https://agentskills.io"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
        >
          Agent Skills
        </a>. The table is every skill in the repo, the version it is on, and whether it is live or still pending. A higher version means that skill has been worked more.
      </p>
    </div>
  </div>

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
    Kickoff prompt
  </h2>
  <div class="mt-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-4 shadow-md shadow-neutral-900/10 dark:border-emerald-800 dark:bg-emerald-950 dark:shadow-black/40">
    <div class="flex items-start justify-between gap-8">
      <p class="min-w-0 pt-1 font-mono text-sm font-bold leading-relaxed text-neutral-900 dark:text-neutral-50">
        {prompt}
      </p>
      <button
        type="button"
        id="maturity-prompt-copy"
        data-prompt-copy={prompt}
        aria-label="Copy"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-neutral-900 text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" aria-hidden="true">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
          <path d="M10.5 5.5 V3.25 A1.25 1.25 0 0 0 9.25 2 H3.25 A1.25 1.25 0 0 0 2 3.25 V9.25 A1.25 1.25 0 0 0 3.25 10.5 H5.5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <p class="mt-8 text-neutral-600 dark:text-neutral-400">
    Install this skill. I use it when I want to see which of my own skills are getting better.
  </p>
  <Install skill="skill-score" plain />

  <h2 class="mt-12 text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
    Skill maturity
  </h2>
  <div class="mt-4 overflow-x-auto">
    <table class="w-full min-w-[48rem] border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-neutral-200 text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
          <th scope="col" class="py-2 pr-4 font-semibold">Skill</th>
          <th scope="col" class="py-2 pr-4 font-semibold">Version</th>
          <th scope="col" class="py-2 pr-4 font-semibold">Last change</th>
          <th scope="col" class="px-3 py-2 text-center font-semibold">Evals</th>
          <th scope="col" class="px-3 py-2 text-center font-semibold">Assets</th>
          <th scope="col" class="px-3 py-2 text-center font-semibold">References</th>
          <th scope="col" class="py-2 font-semibold">Status</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-neutral-200 dark:border-neutral-800">
              <th scope="row" class="py-3 pr-4 font-medium text-neutral-900 dark:text-neutral-50">
                <a href={row.href} class="underline underline-offset-4">
                  /{row.name}
                </a>
              </th>
              <td class="py-3 pr-4 tabular-nums text-neutral-600 dark:text-neutral-400">
                {row.version ? `v${row.version}` : "—"}
              </td>
              <td class="py-3 pr-4 text-neutral-600 dark:text-neutral-400">
                {
                  row.updated ? (
                    <>
                      {formatRuleUpdated(row.updated)}{" "}
                      <span class="text-neutral-400 dark:text-neutral-500">({formatDaysAgo(row.updated)})</span>
                    </>
                  ) : (
                    "—"
                  )
                }
              </td>
              <td class="px-3 py-3 text-center tabular-nums text-neutral-600 dark:text-neutral-400">{row.evals}</td>
              <td class="px-3 py-3 text-center tabular-nums text-neutral-600 dark:text-neutral-400">{row.assets}</td>
              <td class="px-3 py-3 text-center tabular-nums text-neutral-600 dark:text-neutral-400">{row.references}</td>
              <td class="py-3">
                <span
                  class:list={[
                    "inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold",
                    row.live
                      ? "border-emerald-200 bg-emerald-50 text-emerald-950 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-100"
                      : "border-neutral-200 bg-neutral-50 text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300",
                  ]}
                >
                  {row.live ? "Live" : "Pending"}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>

<script>
  const button = document.getElementById("maturity-prompt-copy");
  button?.addEventListener("click", async () => {
    if (!(button instanceof HTMLButtonElement)) return;
    await navigator.clipboard.writeText(button.dataset.promptCopy ?? "");
    const previous = button.getAttribute("aria-label");
    button.setAttribute("aria-label", "Copied");
    window.setTimeout(() => {
      if (previous) button.setAttribute("aria-label", previous);
    }, 1200);
  });
</script>
