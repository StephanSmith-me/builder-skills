---
import Base from "../layouts/Base.astro";
import RepoCallout from "../components/RepoCallout.astro";
import { HEADSHOT_URL, MAIN_SITE } from "../lib/brand";
import { formatDaysAgo, publicRule } from "../lib/ruleMeta";

const description =
  "You are good enough. Don't listen to AI haters. You can build it!";

const skills = [
  {
    name: "/observability",
    href: "/observability",
    aside: "How do I know my app does what we set out to do?",
    shadow: true,
  },
  {
    name: "/security",
    href: "/security",
    aside: "How do I know my app is secure and ready for active customers?",
    shadow: true,
  },
  {
    name: "/scalability",
    href: "/scalability",
    aside: "How do I know my app will work in the wild when customers start to use it?",
    shadow: true,
  },
  {
    name: "/day-to-day",
    href: "/day-to-day",
    aside: "How do I handle CI/CD so my AI work is visible?",
    shadow: true,
  },
  {
    name: "/blindspots",
    href: "/blindspots",
    aside: "A stack review for the patterns most apps need at some point.",
    shadow: true,
  },
  {
    name: "/gallery",
    href: "/gallery",
    aside:
      "Vendor skills, one product at a time. Infisical is written. Sentry, Cloudflare, ImprovMX, and GitHub are stubs.",
    shadow: true,
  },
];
---

<Base title="You are good enough — Stephan Smith" description={description}>
  <div class="mx-auto max-w-3xl text-center">
  <p class="mb-4 inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">
    AI Builder Rules
  </p>
  <h1 class="text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50">
    <span class="block">You are good enough.</span>
    <span class="block">Don't listen to AI haters.</span>
    <span class="block">You can build it!</span>
  </h1>
  <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
    For the past two years I have been doing code reviews, and finding the patterns that
    cause complexity and slow down impact. So I have taken all my
    wins and turned them into a set of AI rules that work everywhere.
  </p>
  <ul class="mt-10 grid gap-3 text-left">
    {
      skills.map((skill) =>
        skill.aside ? (
          <li class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            {
              skill.href ? (
                <a
                  href={skill.href}
                  class:list={[
                    "relative shrink-0 cursor-pointer rounded-lg border border-neutral-200 px-4 py-4 pr-20 transition-colors hover:border-neutral-400 sm:w-72 dark:border-neutral-800 dark:hover:border-neutral-600",
                    skill.shadow && "shadow-md shadow-neutral-900/10 dark:shadow-black/40",
                  ]}
                >
                  <p class="absolute top-3 right-3 text-right text-[0.65rem] leading-tight text-neutral-500 dark:text-neutral-400">
                    {
                      skill.soon ? (
                        <span class="block">Soon</span>
                      ) : (
                        <>
                          <span class="block">v{publicRule(skill.href.slice(1)).version}</span>
                          <span class="block">{formatDaysAgo(publicRule(skill.href.slice(1)).updated)}</span>
                        </>
                      )
                    }
                  </p>
                  <h2 class="text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
                    {skill.name}
                  </h2>
                </a>
              ) : (
                <div
                  class:list={[
                    "relative shrink-0 rounded-lg border border-neutral-200 px-4 py-4 pr-20 sm:w-72 dark:border-neutral-800",
                    skill.shadow && "shadow-md shadow-neutral-900/10 dark:shadow-black/40",
                  ]}
                >
                  <p class="absolute top-3 right-3 text-right text-[0.65rem] leading-tight text-neutral-500 dark:text-neutral-400">
                    <span class="block">v{publicRule(skill.name.slice(1)).version}</span>
                    <span class="block">{formatDaysAgo(publicRule(skill.name.slice(1)).updated)}</span>
                  </p>
                  <h2 class="text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
                    {skill.name}
                  </h2>
                </div>
              )
            }
            <p class="text-neutral-600 dark:text-neutral-400">
              {skill.soon ? (
                <>
                  <strong class="font-semibold text-neutral-900 dark:text-neutral-50">Coming soon.</strong>{" "}
                  {skill.aside.replace(/^Coming soon\.\s*/, "")}
                </>
              ) : (
                skill.aside
              )}{" "}
              {skill.linkHref ? (
                <a
                  href={skill.linkHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50"
                >
                  {skill.linkLabel}
                </a>
              ) : null}
            </p>
          </li>
        ) : null,
      )
    }
  </ul>
  <RepoCallout />
  <hr class="mx-auto mt-12 w-full border-0 border-t border-neutral-300 dark:border-neutral-700" />
  <section class="mx-auto mt-16 mb-20 w-fit max-w-full text-left" aria-label="About Stephan">
    <div class="flex items-start gap-4">
    <img
      src={HEADSHOT_URL}
      alt=""
      width="112"
      height="112"
      class="h-28 w-28 shrink-0 rounded-xl object-cover ring-1 ring-neutral-200 dark:ring-neutral-700"
    />
    <div>
      <p class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
        I'm Stephan
      </p>
      <p class="mt-0.5 text-lg text-neutral-500 dark:text-neutral-400">
        Tech Transactions and fractional CTO
      </p>
      <p class="mt-2 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
        I work across teams and projects. I review what people build with AI, and I help them get it
        out the door.
        <a
          href="https://book.stephansmith.me"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50"
        >
          Book a call
        </a>
        , or see
        <a
          href={`${MAIN_SITE}/work-with-me`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50"
        >
          how to work with me
        </a>
        .
      </p>
    </div>
    </div>
  </section>
  </div>
</Base>
