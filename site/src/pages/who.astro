---
import Base from "../layouts/Base.astro";

const description =
  "These are my tools. For vibe coders already building, and for tech leaders who want the patterns, not a drop-in product.";

const vibeCoders = {
  name: "Vibe coders",
  detail:
    "A lot of people are building a lot of things, and historically, developers have said that they won't be able to do it. I absolutely hate that, so this is my solution: to give tools to people who are already building amazing things.",
};

const techLeaders = {
  name: "Tech leads and builders",
  detail:
    "This is for tech leads and builders that want to think about the patterns in a scalable manner, along with AI, not just as a drop-in product.",
};
---

<Base title="Who is this for? — Stephan Smith" description={description}>
  <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50">
    Who is this for?
  </h1>
  <ul class="mt-10 grid max-w-4xl gap-3">
    <li class="rounded-lg border border-neutral-200 px-4 py-5 dark:border-neutral-800">
      <p class="text-2xl font-normal leading-snug tracking-tight text-neutral-900 dark:text-neutral-50">
        TL;DR: This is from <strong class="font-semibold">me</strong>. These are my tools I use every day.
      </p>
    </li>
    <li class="rounded-lg border border-neutral-200 px-4 py-4 dark:border-neutral-800">
      <h2 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
        {vibeCoders.name}
      </h2>
      <p class="mt-2 text-lg leading-relaxed text-neutral-900 dark:text-neutral-50">{vibeCoders.detail}</p>
    </li>
    <li class="rounded-lg border border-neutral-200 px-4 py-4 dark:border-neutral-800">
      <h2 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
        {techLeaders.name}
      </h2>
      <p class="mt-2 text-lg leading-relaxed text-neutral-900 dark:text-neutral-50">{techLeaders.detail}</p>
      <p class="mt-4 text-lg leading-relaxed text-neutral-900 dark:text-neutral-50">
        AI is displacing a lot of stakeholders, and developers, CTOs, tech enablers, and tech builders are among them. Our value and our place are changing, and this is one of these tools that allows me to add value back to that community.
      </p>
    </li>
  </ul>
</Base>
