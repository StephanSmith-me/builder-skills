---
import Base from "../../layouts/Base.astro";
import Install from "../../components/Install.astro";
import McpTransition from "../../components/McpTransition.astro";
import { loadEvalPrompt, loadSkill, loadSkills } from "../../lib/skills";
import { quoteAtor, statementForSkill, toolForSkill } from "../../lib/tools";
import Subskills from "../../components/Subskills.astro";
import Writings from "../../components/Writings.astro";

export function getStaticPaths() {
  return loadSkills().map((skill) => ({
    params: { slug: skill.slug },
  }));
}

const { slug } = Astro.params;
const skill = loadSkill(slug ?? "");
const tool = toolForSkill(slug ?? "");

if (!skill) {
  throw new Error(`Unknown skill: ${slug}`);
}

const prompt = tool?.kickoff ?? loadEvalPrompt(skill.slug);
const wideMark = tool?.logo.endsWith("/infisical.png") ?? false;
const displayName = quoteAtor(tool?.name ?? skill.title);
const configured = statementForSkill(skill.slug);
const statement = configured ?? tool?.stack ?? skill.description;
const paragraphs = statement.split(/\n\n+/);
---

<Base title={`${displayName} — Stephan Smith`} description={paragraphs[0]}>
  <div class="relative">
    {
      tool && (
        <a
          href={tool.href}
          aria-label={`${tool.aka ?? tool.name} on Tools I Use`}
          class="absolute top-0 right-0"
        >
          <img
            src={tool.logo}
            alt=""
            width={wideMark ? 320 : 112}
            height={wideMark ? 140 : 112}
            class:list={[
              "rounded-xl border object-contain",
              wideMark
                ? "aspect-[320/140] w-56 border-neutral-900 bg-black sm:w-64"
                : "h-24 w-24 border-neutral-200 bg-white p-2 sm:h-28 sm:w-28 dark:border-neutral-800",
            ]}
          />
        </a>
      )
    }
    <p class:list={["mb-4", tool && (wideMark ? "pr-60 sm:pr-72" : "pr-28 sm:pr-32")]}>
      <a
        href="/gallery"
        class="inline-flex items-center gap-1.5 text-sm text-neutral-500 underline-offset-4 hover:text-neutral-900 hover:underline dark:text-neutral-400 dark:hover:text-neutral-50"
      >
        <span aria-hidden="true">←</span>
        Gallery
      </a>
    </p>
    <div class:list={["flex flex-wrap items-center gap-x-3 gap-y-2", tool && (wideMark ? "pr-60 sm:pr-72" : "pr-28 sm:pr-32")]}>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50">
        {displayName}
      </h1>
      {
        tool && (
          <span
            class:list={[
              "rounded-full border px-2.5 py-0.5 text-xs font-semibold",
              tool.readiness === "ready"
                ? "border-emerald-200 bg-emerald-50 text-emerald-950 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-100"
                : "border-neutral-200 bg-neutral-50 text-neutral-600 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300",
            ]}
          >
            {tool.readiness === "ready" ? "Tools I use" : "On the workbench"}
          </span>
        )
      }
      {skill.stub && (
        <span class="rounded-full border border-neutral-200 px-2.5 py-0.5 text-xs text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
          Stub
        </span>
      )}
      {skill.version && (
        <span class="rounded-full border border-neutral-200 px-2.5 py-0.5 text-xs text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
          v{skill.version}
        </span>
      )}
      {
        skill.referenceCount > 0 && (
          <span class="rounded-full border border-neutral-200 px-2.5 py-0.5 text-xs text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
            {skill.referenceCount} reference{skill.referenceCount === 1 ? "" : "s"}
          </span>
        )
      }
    </div>
    {
      tool?.aka && (
        <p class:list={["mt-2 text-lg text-neutral-500 dark:text-neutral-400", tool && (wideMark ? "pr-60 sm:pr-72" : "pr-28 sm:pr-32")]}>
          aka{" "}
          {tool.url ? (
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-50"
            >
              {tool.aka}
            </a>
          ) : (
            tool.aka
          )}
        </p>
      )
    }
  </div>
  {
    paragraphs.map((paragraph) => {
      const mark = "Wallace and Gromit";
      const at = paragraph.indexOf(mark);
      return (
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          {at === -1 ? (
            paragraph
          ) : (
            <>
              {paragraph.slice(0, at)}
              <a
                href="https://en.wikipedia.org/wiki/Wallace_%26_Gromit"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-neutral-900 underline underline-offset-4 dark:text-neutral-50"
              >
                {mark}
              </a>
              {paragraph.slice(at + mark.length)}
            </>
          )}
        </p>
      );
    })
  }
  {
    prompt && (
      <>
        <h2 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">
          Kickoff prompt
        </h2>
        <div class="mt-3 flex items-start justify-between gap-8 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-4 shadow-md shadow-neutral-900/10 dark:border-emerald-800 dark:bg-emerald-950 dark:shadow-black/40">
          <p class="min-w-0 pt-1 font-mono text-sm font-bold leading-relaxed text-neutral-900 dark:text-neutral-50">
            {prompt}
          </p>
          <button
            type="button"
            data-eval-copy={prompt}
            class="shrink-0 rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
          >
            Copy
          </button>
        </div>
      </>
    )
  }
  {tool && <Writings posts={tool.posts} />}
  <Install skill={skill.slug} />
  {!tool && !configured && (
    <article class="skill-body mt-10 max-w-2xl text-neutral-800 dark:text-neutral-200" set:html={skill.html} />
  )}
  <Subskills parent={skill.slug} />
  <McpTransition />
  {
    prompt && (
      <script>
        document.querySelectorAll<HTMLButtonElement>("[data-eval-copy]").forEach((button) => {
          button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(button.dataset.evalCopy ?? "");
            const label = button.textContent;
            button.textContent = "Copied";
            window.setTimeout(() => {
              button.textContent = label;
            }, 1200);
          });
        });
      </script>
    )
  }
</Base>
